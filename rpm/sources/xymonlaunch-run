#!/bin/sh
#
# Role dispatcher for xymonlaunch.service, written for this packaging.
# The xymon (server) and xymon-client packages conflict, so exactly one
# is installed; the server tree's presence decides which role runs.
#
# Server role: what the unit's ExecStart did when it was server-only --
# xymoncmd loads xymonserver.cfg and execs xymonlaunch on the server's
# tasks.cfg, which includes the client's duties.
#
# Client role: foreground equivalent of upstream client/runclient.sh
# "start". runclient.sh computes this environment, forks xymonlaunch
# and exits; a Type=simple unit needs the same environment with
# xymonlaunch kept in the foreground. CLIENTHOSTNAME and CLIENTOS
# arrive from /etc/sysconfig/xymon-client via the unit, when set
# there.
#
# Upstream xymon#408 proposes this as "runclient.sh foreground"; when
# that lands, the client half here becomes a call to it.

XYMONSERVERHOME=/usr/lib/xymon/server
XYMONCLIENTHOME=/usr/lib/xymon/client

# The role marker is the server package's unit drop-in, the same file
# the packages' scriptlets key their swap handling off -- one encoding
# of "which role is installed", so the two cannot disagree. Its presence
# means the server package is installed, so a missing or unusable server
# binary is a broken installation: fail loudly rather than silently
# falling back to the client role, which would look healthy while the
# whole fleet's monitoring is down.
if [ -e /usr/lib/systemd/system/xymonlaunch.service.d/server.conf ]; then
	if [ ! -x "$XYMONSERVERHOME/bin/xymond" ] ||
	   [ ! -x "$XYMONSERVERHOME/bin/xymoncmd" ] ||
	   [ ! -x "$XYMONSERVERHOME/bin/xymonlaunch" ]; then
		echo "xymonlaunch-run: server role selected but $XYMONSERVERHOME/bin is incomplete" >&2
		exit 1
	fi
	exec "$XYMONSERVERHOME/bin/xymoncmd" \
	     "$XYMONSERVERHOME/bin/xymonlaunch" --no-daemon "$@"
fi

MACHINEDOTS="${CLIENTHOSTNAME:-$(uname -n)}"
SERVEROSTYPE="${CLIENTOS:-$(uname -s | tr '[ABCDEFGHIJKLMNOPQRSTUVWXYZ/]' '[abcdefghijklmnopqrstuvwxyz_]')}"
MACHINE="$(echo "$MACHINEDOTS" | sed -e 's/\./,/g')"
XYMONOSSCRIPT="xymonclient-$SERVEROSTYPE.sh"
export XYMONCLIENTHOME MACHINEDOTS MACHINE SERVEROSTYPE XYMONOSSCRIPT

# --env as well as the exports above: systemd starts this with an empty
# environment, and the launcher expands the paths in clientlaunch.cfg --
# LOGFILE, CMD, and PIDFILE once xymon#172 lands -- before it reads any
# task's own ENVFILE. The exports alone leave it resolving those from
# compiled-in defaults.
exec "$XYMONCLIENTHOME/bin/xymonlaunch" --no-daemon \
     --env="$XYMONCLIENTHOME/etc/xymonclient.cfg" \
     --config="$XYMONCLIENTHOME/etc/clientlaunch.cfg" "$@"
