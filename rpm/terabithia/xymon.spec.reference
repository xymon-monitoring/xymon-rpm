# See README for rmd160c.c credits - FreeBSD
Provides:	bundled(librmd) = 20060414
# See README for sha2.c credits
Provides:	bundled(sha2-ogay) = 20070202

%define		md5Ver		20020413
Provides:	bundled(md5-deutsch) = %{md5Ver}
Source73:	https://downloads.sourceforge.net/libmd5-rfc/md5.tar.gz


%define		caresVer	1.15.0
%if %{with systemcares}
BuildRequires:	c-ares-devel >= 1.5.1
%else
Provides:	bundled(c-ares) = %{caresVer}
%endif

# Digest
%define		xxHashVer	0.7.1
Source74:	https://github.com/Cyan4973/xxHash/archive/v%{xxHashVer}.tar.gz
#Source741:	xxhash-intrin.patch
%if %{with systemxxhash}
BuildRequires:	xxhash-devel
%else
Provides:	bundled(xxHash) = %{xxHashVer}
%endif

# Compression
